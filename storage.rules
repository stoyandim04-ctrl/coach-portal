rules_version = '2';

// Coach Portal — Storage rules for progress photos: checkins/{token}/{checkinId}/{slot}.jpg
service firebase.storage {
  match /b/{bucket}/o {
    match /checkins/{token}/{checkinId}/{file} {
      function link() {
        return firestore.get(/databases/(default)/documents/checkinLinks/$(token)).data;
      }

      // Anyone holding a valid link may upload an image (max 5 MB).
      allow create: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && firestore.exists(/databases/(default)/documents/checkinLinks/$(token));

      // The owning coach and the linked client account may view; only the coach may delete.
      allow read: if request.auth != null
        && (link().coachId == request.auth.uid || link().get('clientUserId', null) == request.auth.uid);
      allow delete: if request.auth != null && link().coachId == request.auth.uid;
    }
  }
}
